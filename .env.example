# Server-only Tavily credential. Never prefix this with VITE_.
TAVILY_API_KEY=tvly-your-secret-key

# Server-only TypeSafe credential for Jev link review. Never prefix this with VITE_.
TYPESAFE_API_KEY=your-typesafe-secret-key

# Server-only Better Auth settings for email/password and Google sign-in.
# Generate the secret with `openssl rand -base64 32`. BETTER_AUTH_URL is the
# site's origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://permitsearch.app/api/auth/callback/google


# Optional local database configuration for PlanetScale through Hyperdrive.
# CLOUDFLARE_HYPERDRIVE_ID=
# DATABASE_URL=

# Connection string for the PlanetScale `migrator` role, which owns the
# schema. Used only by `npm run db:migrate` on your machine.
MIGRATION_DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require
