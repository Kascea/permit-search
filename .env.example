# Public browser token. Restrict it to local and production site URLs.
VITE_MAPBOX_ACCESS_TOKEN=pk.your_complete_public_token

# Server-only Tavily credential. Never prefix this with VITE_.
TAVILY_API_KEY=tvly-your-secret-key

# Server-only TypeSafe credential for Jev link review. Never prefix this with VITE_.
TYPESAFE_API_KEY=your-typesafe-secret-key

# Optional local database configuration for PlanetScale through Hyperdrive.
# CLOUDFLARE_HYPERDRIVE_ID=
# DATABASE_URL=

# Server-only token for the /api/db/migrate endpoint (npm run db:migrate).
MIGRATION_TOKEN=generate-a-long-random-value
