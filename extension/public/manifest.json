{
  "manifest_version": 3,
  "name": "Permit Search",
  "description": "Fill a city's online permit application from your Permit Search project.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "121",
  "action": { "default_title": "Permit Search" },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "host_permissions": ["https://permitsearch.app/*", "http://localhost:3000/*"],
  "optional_host_permissions": ["https://*/*"]
}
